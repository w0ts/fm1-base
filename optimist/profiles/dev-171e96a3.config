# SPDX-License-Identifier: GPL-3.0-only
# The trial's copy of Optimist's profile dev (config/profiles/dev.config at Optimist commit 171e96a3, the reference
# synths_USBaudio_BTaudio_BTmidi less PHASE and SFLD): its lines verbatim down to the trial's marker, never edited here
# but by copying the profile again. gen_optimist.py makes two headers of it with Optimist's own builder
# (tools/builder/configure.py of the tree it builds from): build/optgen/felucca_config.h, the trial's (everything, the
# trial's block included) and build/optgen/felucca_config_profile.h, the profile as an FM-1 runs it (down to the
# marker: optsim.py, Optimist's own simulator, the flash a user's FM-1 has).
# name: dev
# publish: no
# Claude's working profile (the user, 2026-10-26: "just make a dev profile with just what you need"): the reference less PHASE and the SFLD insert, so it fits while the reference is over
# Synth engines
A2_LADR=1
A2_OTA=1
A2_DIOD=1
A2_MS20=1
ENG_LOFI=0
ENG_SAMPLE=0
ENG_FORMANT=0
ENG_TRIO=0
ENG_DRAWBAR=0
ENG_GRAIN=0
FM6_PK_KEYS=1
FM6_PK_BASS=1
FM6_PK_BELLS=1
FM6_PK_PADS=1
FM6_PK_80S=1
ENG_PLAITS=1
ENG_STRINGS=1
ENG_PHYS=1
ENG_ACID=1
ENG_JUNO=1
UP_FM6=1
# Drums
DRUM_X0X909=1
X909_CYM=0
X909_HAT=2
X0X_TANH=2
DRUM_X0X808=1
DRUM_SAMPLED=0
KIT_ACOUSTIC=0
KIT_DEEP=0
KIT_TIGHT=0
KIT_BRIGHT=0
KIT_DUST=0
DRUM_USR=0
# Sample sets
SET_PIANO=0
SET_BASS=0
SET_VIBES=0
SET_HORNS=0
SET_STRGS=0
SET_FLUTE=0
SET_SCRCH=0
# FX: any number (each track its own)
FX_SLICER=0
FX_DJF=0
FX_DUST=0
TRK_FILT=1
INS_FOLD=1
INS_FUZZ=1
INS_WIDTH=1
INS_HARM=1
INS_SUBOCT=1
INS_GATER=1
# FX: limited instances (once, or a set count)
DLY_LEN=16384
REV_ROOM=0
REV_FDN8=1
REV_POOL=1
FX_PUNCH=0
PUNCH_N=16384
INS_CHORUS=1
INS_DELAY=1
INS_JCHORUS=1
INS_FLANGER=1
INS_XDLY=1
XDLY_LEN=8192
DLY_ARENA=64
PUNCH_LATCH=1
# Sequencer
CHORDPLUS=1
SNAPSHOTS=0
PATTERNS=1
ENERGY=1
REC_PLAIN=1
NOTEGEN=1
CHANCE=1
QNT_SEQ=1
MOTION=1
REC_MODES=1
SL24_XSTEP=1
MICRO=1
FILLS=1
PLOCK=1
QCHAIN=0
COND=1
SEQTOOLS=1
GEN_GRIDS=1
GRIDS_EUCLID=1
GRIDS_LFO=1
GRIDS_VEL=1
# USB & BT & MIDI
USB_AUDIO=1
MIDI_EXPR=0
MIDI_NOTEOUT=0
BLE=1
BT_AUDIO=1
# UI
LCD_BAUD=0
DIV_ORDER=1
# System
ED_LIVE=0
ED_MIX=0
ED_SEQ=0
ED_SCREENS=0
ED_MIRROR=1
TAB_IN_POOL=1
LIVE_SAVE=1
CPU_GUARD=1
CACHE_RAM=2
SL24_SAFE=0
SL24_IMPORT=0

ENG_PHASE=0
INS_SFOLD=0
# ---- the trial: what it changes (the profile above stays as it is; parse() takes the last value of a key)
# Off for lack of support in the trial (fm1-base gives the device's USB, its own Bluetooth stack, its own app.ld and
# boot): never a data format or an address
# (USB audio: on, as the profile has it: Optimist's USB input track and its capture routing on fm1-base's USB audio,
# felucca-bsp's UAC: fm1.toml usb_audio_*, core/opt_core.c; Optimist's io/usb/usb.c is not in the trial)
# (Bluetooth MIDI, BLE, and Bluetooth audio, BT_AUDIO with BT_AFH: on, as the profile has them: fm1-base's own stack,
# fm1.toml ble_stack = "own", the stack Optimist's own; Optimist's screens, its settings record and its mirror on
# plat_ble_* / plat_bta_* through ui/opt_bt.h)
# (the web editor, EDITOR: on, as the profile has it: Optimist's editor over fm1-base's SysEx, opt_editor.h)
# the second core: on, as the profile has it (DUAL 2, said again here): Optimist's split of the render on fm1-base's
# second core (fm1.toml cpu2, core/opt_dual.c); STOCK_SUPPLY's rails are fm1-base's own at every boot (main_fm1.c)
DUAL=2
# (the data cache as RAM, CACHE_RAM: as the profile has it: fm1-base's, fm1.toml cache_ram_ways, felucca-bsp's
# fm1_cache_ram.h; the undo history's second part, the arena that much more of the SRAM: engines.c ARN_UNDO_KEEP)
# (the CPU guard, CPU_GUARD: on, as the profile has it: cpuguard.c, the render calls it, core/opt_core.c opt_half_*; room
# for it from fm1-base's trimmed fonts, fm1.toml font_trim)
# (save while playing, LIVE_SAVE: on, as the profile has it: fm1-base's sliced erase (feat/sliced-erase, felucca-bsp's
# fl_erase4k_sliced, Optimist's own under MPL-2.0) under plat_data_erase; ui/opt_storage.h st_erase: plat_flash_held)
